---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="bg-accent/5 border-border border-accent/20 rounded-3xl border p-8 shadow-[0_20px_40px_rgba(0,108,172,0.12)] sm:p-10"
    >
      <div class="mx-auto max-w-prose space-y-6 text-base leading-8 text-muted-foreground">

        <img
          src="back-on-the-tools-2026-sep-smaller.jpg"
          alt="Back on the Tools cover artwork"
          class="mx-auto block w-5/12 max-w-sm rounded-3xl bg-transparent shadow-lg sm:w-1/3"
        />

        <p class="text-lg font-normal text-foreground">
        Rediscovering the joy of tech work that actually suits you.
        </p>

        <p>
          It used to be easy. Turn up, do a job of work, get paid. Maybe there was some on-call, but you got paid for that, or time in lieu. More than that, you didn't really care because you were 25 and you loved working in tech.
        </p>
        <p>
          But somewhere along the way you grew ambitious, you led, you managed, and that ambition turned on you. Now you don't know which way is up. You feel the younger engineers have all the cards. They are smarter, cheaper, harder working.
        </p>
        <p>
          So what's your next move?
        </p>
        <p>
          Here's what I did....
        </p>

        <section id="newsletter" class="mt-12 sm:mt-16">
          <div class="mx-auto max-w-prose space-y-6 text-base leading-8 text-muted-foreground text-justify">
            <h2 class="text-2xl sm:text-2xl font-semibold">Want to stay up to date?</h2>
            <p class="text-lg sm:text-xs font-normal">You can join my newsletter for writing updates, publication news and opportunities to become an early ARC reader.</p>
            <NewsletterSignup title="Sign up for updates" description="Get book news, writing updates, and launch information straight to your inbox." />
          </div>
        </section>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
